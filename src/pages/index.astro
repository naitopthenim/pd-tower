---
// ✨ AUTO-GENERATED IMPORTS (run: pnpm auto-import)

import Welcome from '../components/Welcome.astro';
import AutoImportShowcase from '../components/AutoImportShowcase.vue';
import Default from '../layouts/Default.astro';
// ✨ NO IMPORTS NEEDED! Components are auto-imported like Nuxt!
// Layout, Welcome, AutoImportShowcase will be automatically imported
---

<Default>
  <Welcome />
  <div class="container mx-auto space-y-8 py-8">
    <div class="text-center">
      <h1 class="mb-4 bg-red-500 text-3xl font-bold text-gray-800">
        Auto-Import Comparison
      </h1>
      <p class="mb-8 text-gray-600">
        See the difference between Astro files (need imports) vs Vue files (TRUE
        auto-imports)
      </p>
    </div>

    <!-- This Vue component demonstrates TRUE auto-imports -->
    <AutoImportShowcase client:load />
  </div>
</Default>
